<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#07070d" />
  <title>OC 心理侧写 × CP 匹配引擎</title>
  <style>
    /* ================= 基础布局 ================= */
    :root {
      --bg: #07070d;
      --panel: rgba(255, 255, 255, 0.035);
      --line: rgba(160, 170, 255, 0.16);
      --text: #e8e9f5;
      --muted: #8b8fa8;
      --pink: #ff4d8d;
      --violet: #8b6cff;
      --cyan: #4dd0ff;
    }

    * { box-sizing: border-box; }

    html, body { margin: 0; padding: 0; }

    body {
      min-height: 100vh;
      color: var(--text);
      font-family: "Noto Sans SC", "PingFang SC", "Microsoft YaHei", system-ui, -apple-system, sans-serif;
      background:
        radial-gradient(900px 520px at 12% -12%, rgba(255, 77, 141, 0.20), transparent 62%),
        radial-gradient(820px 540px at 94% -4%, rgba(77, 208, 255, 0.14), transparent 58%),
        radial-gradient(760px 720px at 50% 118%, rgba(139, 108, 255, 0.18), transparent 62%),
        var(--bg);
      -webkit-font-smoothing: antialiased;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
      background-size: 48px 48px;
      -webkit-mask-image: radial-gradient(circle at 50% 26%, #000 0%, transparent 76%);
      mask-image: radial-gradient(circle at 50% 26%, #000 0%, transparent 76%);
    }

    .site-header {
      position: relative;
      z-index: 1;
      max-width: 1180px;
      margin: 0 auto;
      padding: 58px 24px 26px;
    }

    .site-header h1 {
      margin: 0;
      font-size: clamp(24px, 4vw, 40px);
      line-height: 1.25;
      letter-spacing: 0.04em;
      background: linear-gradient(100deg, #ffffff 0%, #ffc2d8 38%, #a99cff 68%, #7fe6ff 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .site-header h1 .accent {
      font-family: ui-monospace, Consolas, monospace;
      opacity: 0.75;
    }

    .subtitle {
      margin: 10px 0 0;
      font-size: 11px;
      letter-spacing: 0.34em;
      color: var(--muted);
      text-transform: uppercase;
    }

    .layout {
      position: relative;
      z-index: 1;
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 24px 80px;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
      align-items: start;
    }

    .panel-chart { grid-column: 1 / -1; }

    .panel {
      padding: 22px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.012));
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
    }

    .panel h2 {
      margin: 0 0 18px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.24em;
      color: var(--muted);
      text-transform: uppercase;
    }

    .field { margin-bottom: 12px; }

    .field label {
      display: block;
      margin-bottom: 6px;
      font-size: 12px;
      letter-spacing: 0.12em;
      color: var(--muted);
    }

    input[type="text"] {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: rgba(8, 8, 16, 0.78);
      color: var(--text);
      font-family: inherit;
      font-size: 14px;
      letter-spacing: 0.06em;
      outline: none;
      transition: border-color 0.18s, box-shadow 0.18s;
    }

    input[type="text"]::placeholder { color: #5b5f78; }

    input[type="text"]:focus {
      border-color: rgba(255, 77, 141, 0.62);
      box-shadow: 0 0 0 3px rgba(255, 77, 141, 0.12);
    }

    .btn {
      width: 100%;
      padding: 12px 18px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.06);
      color: var(--text);
      font-family: inherit;
      font-size: 14px;
      letter-spacing: 0.08em;
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.2s, opacity 0.2s, border-color 0.2s;
    }

    .btn:hover:not(:disabled) {
      transform: translateY(-1px);
      border-color: rgba(139, 108, 255, 0.6);
    }

    .btn:active:not(:disabled) { transform: translateY(0); }

    .btn:disabled {
      opacity: 0.55;
      cursor: progress;
      transform: none;
    }

    .btn-primary {
      border: none;
      font-weight: 600;
      color: #fff;
      background: linear-gradient(100deg, var(--pink), var(--violet) 58%, #5b7cff);
      box-shadow: 0 12px 32px rgba(255, 77, 141, 0.24);
    }

    .key-out {
      margin-top: 14px;
      padding: 12px 14px;
      border: 1px dashed rgba(255, 77, 141, 0.36);
      border-radius: 10px;
      background: rgba(255, 77, 141, 0.06);
    }

    .key-out .key-label {
      display: block;
      margin-bottom: 4px;
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--muted);
    }

    .key-out code {
      font-family: ui-monospace, Consolas, monospace;
      font-size: 15px;
      letter-spacing: 0.12em;
      color: #ffc2d8;
      word-break: break-all;
    }

    .divider {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 20px 0 14px;
      font-size: 11px;
      letter-spacing: 0.2em;
      color: var(--muted);
    }

    .divider::before,
    .divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: var(--line);
    }

    .session {
      margin: 14px 0 0;
      font-size: 12px;
      color: var(--muted);
      letter-spacing: 0.06em;
    }

    .session.is-online { color: #7fe6b0; }
    .session.is-online::before { content: "● "; }

    .file-drop {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      padding: 28px 18px;
      border: 1px dashed rgba(139, 108, 255, 0.42);
      border-radius: 14px;
      background: rgba(139, 108, 255, 0.06);
      text-align: center;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
    }

    .file-drop:hover {
      background: rgba(139, 108, 255, 0.13);
      border-color: rgba(139, 108, 255, 0.75);
    }

    .file-icon { font-size: 22px; line-height: 1; opacity: 0.9; }
    .file-title { font-size: 14px; letter-spacing: 0.06em; }
    .file-hint { font-size: 11px; color: var(--muted); letter-spacing: 0.08em; }

    .file-name {
      margin: 12px 0;
      font-size: 12px;
      color: var(--muted);
      word-break: break-all;
      letter-spacing: 0.04em;
    }

    .tips {
      margin: 14px 0 0;
      font-size: 11px;
      line-height: 1.8;
      color: var(--muted);
    }

    .chart-empty {
      font-size: 13px;
      letter-spacing: 0.2em;
      color: rgba(139, 143, 168, 0.85);
    }

    /* ================= 合盘交互 ================= */
    [hidden] { display: none !important; }

    .radar-stage {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .radar-slot {
      padding: 14px;
      border: 1px solid rgba(160, 170, 255, 0.14);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.02);
      transform-origin: center;
    }

    .slot-title {
      margin: 0 0 8px;
      font-size: 12px;
      letter-spacing: 0.16em;
      color: rgba(139, 143, 168, 0.9);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .radar-canvas {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 380px;
      border-radius: 12px;
      background: radial-gradient(circle at 50% 50%, rgba(139, 108, 255, 0.08), transparent 70%);
      transform-origin: center;
    }

    .radar-canvas--derived { height: 440px; }

    .match-bar {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-top: 18px;
    }

    .match-bar .btn {
      width: auto;
      min-width: 180px;
      padding-left: 28px;
      padding-right: 28px;
    }

    .match-hint {
      margin: 0;
      font-size: 12px;
      letter-spacing: 0.06em;
      color: rgba(139, 143, 168, 0.9);
    }

    .btn-ghost {
      width: auto;
      margin-top: 18px;
      padding-left: 26px;
      padding-right: 26px;
      background: rgba(255, 255, 255, 0.04);
      border-color: rgba(160, 170, 255, 0.22);
      color: rgba(232, 233, 245, 0.85);
    }

    .match-entry {
      margin-top: 18px;
      padding: 18px 20px;
      border: 1px dashed rgba(255, 77, 141, 0.35);
      border-radius: 14px;
      background: rgba(255, 77, 141, 0.05);
    }

    .entry-title {
      margin: 0 0 8px;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.06em;
      color: #ffc2d8;
    }

    .entry-desc {
      margin: 0;
      font-size: 13px;
      line-height: 1.9;
      color: rgba(232, 233, 245, 0.8);
    }

    .modal {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(4, 4, 10, 0.74);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
    }

    .modal-card {
      position: relative;
      width: min(560px, 100%);
      padding: 24px;
      border: 1px solid rgba(160, 170, 255, 0.2);
      border-radius: 18px;
      background: linear-gradient(180deg, #14131f, #0b0a14);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.62);
    }

    .modal-title {
      margin: 0 0 8px;
      font-size: 17px;
      font-weight: 700;
      letter-spacing: 0.06em;
      color: #ffc2d8;
    }

    .modal-tip {
      margin: 0 0 16px;
      font-size: 12px;
      line-height: 1.8;
      color: rgba(139, 143, 168, 0.95);
    }

    .modal-textarea {
      width: 100%;
      min-height: 150px;
      padding: 14px;
      border: 1px solid rgba(160, 170, 255, 0.18);
      border-radius: 12px;
      background: rgba(8, 8, 16, 0.82);
      color: #e8e9f5;
      font-family: inherit;
      font-size: 14px;
      line-height: 1.75;
      resize: vertical;
      outline: none;
      transition: border-color 0.18s, box-shadow 0.18s;
    }

    .modal-textarea::placeholder { color: #5b5f78; }

    .modal-textarea:focus {
      border-color: rgba(255, 77, 141, 0.6);
      box-shadow: 0 0 0 3px rgba(255, 77, 141, 0.12);
    }

    .modal-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 8px 0 16px;
      font-size: 11px;
      letter-spacing: 0.06em;
      color: rgba(139, 143, 168, 0.9);
    }

    .modal-error { color: #ff8aa8; }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
    }

    .modal-actions .btn {
      width: auto;
      min-width: 132px;
    }

    .modal-actions .btn-ghost { margin-top: 0; }

    .explode-anim {
      transform: scale(1.2);
      opacity: 0;
      transition: all 0.5s ease-in-out;
    }

    @media (max-width: 860px) {
      .site-header { padding-top: 40px; }
      .layout { grid-template-columns: 1fr; gap: 16px; }
      .radar-stage { grid-template-columns: 1fr; }
      .radar-canvas { height: 320px; }
      .radar-canvas--derived { height: 380px; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { transition: none !important; }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <h1>OC 心理侧写 <span class="accent">×</span> CP 匹配引擎</h1>
    <p class="subtitle">Persona Profile Engine / Ten Dimensions</p>
  </header>

  <main class="layout">
    <section class="panel">
      <h2>01 / 灵魂契约</h2>

      <div class="field">
        <label for="nickname-input">昵称</label>
        <input id="nickname-input" type="text" maxlength="24" placeholder="例：雪之下雪乃" autocomplete="off" />
      </div>
      <button id="btn-register" class="btn btn-primary" type="button">签定灵魂契约</button>

      <div class="key-out">
        <span class="key-label">你的密钥</span>
        <code id="register-key">————</code>
      </div>

      <div class="divider">已有密钥</div>

      <div class="field">
        <label for="key-input">密钥</label>
        <input id="key-input" type="text" placeholder="KEY-XXXX-XXXX" autocomplete="off" />
      </div>
      <button id="btn-login" class="btn" type="button">使用密钥登录</button>

      <p class="session" id="session-status">未登录</p>

      <div class="divider">券码兑换</div>

      <div class="field">
        <label for="coupon-input">体验券码</label>
        <input id="coupon-input" type="text" placeholder="VIP-XXXX" autocomplete="off" />
      </div>
      <button id="btn-redeem" class="btn" type="button">兑换券码（+5 虚拟币）</button>
    </section>

    <section class="panel">
      <h2>02 / 侧写素材</h2>

      <label class="file-drop" for="file-input">
        <span class="file-icon">⇪</span>
        <span class="file-title">点击上传角色 TXT</span>
        <span class="file-hint">单文件 ≤ 30000 字符</span>
      </label>
      <input id="file-input" type="file" accept=".txt,text/plain" hidden />

      <p class="file-name" id="file-name">尚未选择文件</p>
      <button id="btn-upload" class="btn btn-primary" type="button">开始侧写</button>

      <p class="tips">上传后将调用 DeepSeek 对角色进行 10 维心理评分，按字数扣除余额。<br />侧写结果会先打印在浏览器控制台中。</p>

      <button id="btn-feedback-open" class="btn btn-ghost" type="button">✎ 提交反馈 · 领体验券</button>
    </section>

    <section class="panel panel-chart">
      <h2>03 / 人格雷达</h2>
      <div class="radar-stage">
        <div class="radar-slot">
          <p class="slot-title" id="slot-title-a">OC 1 · 待侧写</p>
          <div id="radar-chart-a" class="radar-canvas"><span class="chart-empty">等待侧写数据…</span></div>
        </div>
        <div class="radar-slot">
          <p class="slot-title" id="slot-title-b">OC 2 · 待侧写</p>
          <div id="radar-chart-b" class="radar-canvas"><span class="chart-empty">等待侧写数据…</span></div>
        </div>
      </div>
      <div class="match-bar">
        <button id="btn-match" class="btn btn-primary" type="button" disabled>开始合盘</button>
        <p class="match-hint" id="match-hint">上传两份 OC 文本后即可合盘</p>
      </div>
    </section>

    <section class="panel panel-chart" id="panel-derived" hidden>
      <h2>04 / 合盘结果</h2>
      <div id="derived-chart" class="radar-canvas radar-canvas--derived"></div>
      <div class="match-entry">
        <p class="entry-title" id="entry-title"></p>
        <p class="entry-desc" id="entry-desc"></p>
      </div>
      <button id="btn-reset" class="btn btn-ghost" type="button">重新合盘</button>
    </section>
  </main>

  <div class="modal" id="feedback-modal" hidden>
    <div class="modal-backdrop" id="feedback-backdrop"></div>
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="feedback-title">
      <h3 class="modal-title" id="feedback-title">提交反馈 · 领取 VIP 体验券</h3>
      <p class="modal-tip">写下 20-200 字的真实感受或建议，通过后立即获得一张 VIP-XXXX 体验券（兑 5 虚拟币）。</p>

      <textarea
        id="feedback-text"
        class="modal-textarea"
        maxlength="200"
        placeholder="例如：希望合盘结果能生成分享链接，直接发给朋友……"
      ></textarea>

      <div class="modal-meta">
        <span id="feedback-count">0 / 200</span>
        <span class="modal-error" id="feedback-error"></span>
      </div>

      <div class="modal-actions">
        <button class="btn btn-ghost" id="btn-feedback-cancel" type="button">取消</button>
        <button class="btn btn-primary" id="btn-feedback-submit" type="button">提交并领取</button>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.1/dist/echarts.min.js"></script>
  <script type="module">
    /* ==================== 1. 工具层（原 utils.js）：AES + 海报 ==================== */

    const SECRET = 'OC_PSYCHE_2024';

    const CRYPTOJS_ESM = 'https://cdn.jsdelivr.net/npm/crypto-js@4.2.0/+esm';
    const CRYPTOJS_UMD = 'https://cdn.jsdelivr.net/npm/crypto-js@4.2.0/crypto-js.min.js';

    async function loadCryptoJS() {
      if (globalThis.CryptoJS) return globalThis.CryptoJS;

      try {
        const mod = await import(CRYPTOJS_ESM);
        const lib = (mod && mod.default) || mod;
        if (lib && lib.AES) {
          globalThis.CryptoJS = lib;
          return lib;
        }
      } catch {
        /* 回退到 UMD 脚本 */
      }

      await new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = CRYPTOJS_UMD;
        script.async = true;
        script.onload = resolve;
        script.onerror = () => reject(new Error('CryptoJS 加载失败，请检查网络'));
        document.head.appendChild(script);
      });

      if (!globalThis.CryptoJS) throw new Error('CryptoJS 加载失败，请检查网络');
      return globalThis.CryptoJS;
    }

    let CryptoJS = globalThis.CryptoJS || null;

    if (!CryptoJS) {
      try {
        CryptoJS = await loadCryptoJS();
      } catch (error) {
        console.warn('[utils] CryptoJS 加载失败，加密功能暂不可用：', error && error.message);
      }
    }

    function requireCrypto() {
      if (!CryptoJS) throw new Error('CryptoJS 未就绪，请检查网络后刷新页面');
      return CryptoJS;
    }

    function toUrlSafe(base64) {
      return base64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    function fromUrlSafe(value) {
      let base64 = String(value).trim().replace(/\s+/g, '+').replace(/-/g, '+').replace(/_/g, '/');
      while (base64.length % 4 !== 0) base64 += '=';
      return base64;
    }

    function encryptOC(data) {
      const plain = typeof data === 'string' ? data : JSON.stringify(data ?? null);
      const cipher = requireCrypto().AES.encrypt(plain, SECRET).toString();
      return toUrlSafe(cipher);
    }

    function decryptOC(cipherText) {
      if (typeof cipherText !== 'string' || !cipherText.trim()) {
        throw new Error('缺少密文');
      }

      let plain;
      try {
        plain = requireCrypto().AES.decrypt(fromUrlSafe(cipherText), SECRET).toString(CryptoJS.enc.Utf8);
      } catch {
        throw new Error('解密失败：密钥不匹配或数据已损坏');
      }

      if (!plain) throw new Error('解密失败：密钥不匹配或数据已损坏');

      try {
        return JSON.parse(plain);
      } catch {
        return plain;
      }
    }

    const DIMENSION_META = [
      { key: 'empathy', label: '共情力', en: 'EMPATHY' },
      { key: 'order', label: '秩序感', en: 'ORDER' },
      { key: 'intellect', label: '智谋度', en: 'INTELLECT' },
      { key: 'vitality', label: '向阳心', en: 'VITALITY' },
      { key: 'pride', label: '自尊感', en: 'PRIDE' },
      { key: 'dominance', label: '支配欲', en: 'DOMINANCE' },
      { key: 'self_destruction', label: '自毁度', en: 'SELF-DESTRUCTION' },
      { key: 'masochism', label: '痛觉度', en: 'MASOCHISM' },
      { key: 'obsession', label: '偏执狂', en: 'OBSESSION' },
      { key: 'destruction', label: '破坏欲', en: 'DESTRUCTION' },
    ];

    const CN_FONT = '"Noto Sans SC", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif';
    const MONO_FONT = 'ui-monospace, Consolas, "Courier New", monospace';

    const CARD_WIDTH = 1080;
    const CARD_HEIGHT = 1920;
    const PADDING = 100;

    function clampScore(value) {
      const num = Number(value);
      if (!Number.isFinite(num)) return 0;
      return Math.min(100, Math.max(0, Math.round(num)));
    }

    function normalizeScores(data) {
      const source = data && typeof data.scores === 'object' && data.scores !== null ? data.scores : data || {};
      const scores = {};
      for (const meta of DIMENSION_META) {
        scores[meta.key] = clampScore(source[meta.key]);
      }
      return scores;
    }

    function roundRect(ctx, x, y, width, height, radius) {
      const r = Math.min(radius, width / 2, height / 2);
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.arcTo(x + width, y, x + width, y + height, r);
      ctx.arcTo(x + width, y + height, x, y + height, r);
      ctx.arcTo(x, y + height, x, y, r);
      ctx.arcTo(x, y, x + width, y, r);
      ctx.closePath();
    }

    function paintGlow(ctx, x, y, radius, color) {
      const gradient = ctx.createRadialGradient(x, y, 0, x, y, radius);
      gradient.addColorStop(0, color);
      gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = gradient;
      ctx.fillRect(x - radius, y - radius, radius * 2, radius * 2);
    }

    function fitFontSize(ctx, text, maxWidth, startSize, weight, minSize) {
      let size = startSize;
      while (size > minSize) {
        ctx.font = `${weight} ${size}px ${CN_FONT}`;
        if (ctx.measureText(text).width <= maxWidth) break;
        size -= 2;
      }
      return size;
    }

    function formatDate(date) {
      const pad = (n) => String(n).padStart(2, '0');
      return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
    }

    function generateOCCard(data = {}) {
      const name = String(data.name || data.nickname || '无名角色').slice(0, 24);
      const scores = normalizeScores(data);

      const canvas = document.createElement('canvas');
      canvas.width = CARD_WIDTH;
      canvas.height = CARD_HEIGHT;

      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('当前浏览器不支持 Canvas');

      const right = CARD_WIDTH - PADDING;

      const background = ctx.createLinearGradient(0, 0, 0, CARD_HEIGHT);
      background.addColorStop(0, '#08080f');
      background.addColorStop(0.55, '#0b0a18');
      background.addColorStop(1, '#06060c');
      ctx.fillStyle = background;
      ctx.fillRect(0, 0, CARD_WIDTH, CARD_HEIGHT);

      paintGlow(ctx, 200, 140, 620, 'rgba(255, 77, 141, 0.22)');
      paintGlow(ctx, 900, 380, 560, 'rgba(77, 208, 255, 0.14)');
      paintGlow(ctx, 540, 1760, 720, 'rgba(139, 108, 255, 0.18)');

      ctx.strokeStyle = 'rgba(255, 255, 255, 0.035)';
      ctx.lineWidth = 1;
      for (let x = 0; x <= CARD_WIDTH; x += 60) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, CARD_HEIGHT);
        ctx.stroke();
      }
      for (let y = 0; y <= CARD_HEIGHT; y += 60) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(CARD_WIDTH, y);
        ctx.stroke();
      }

      const accent = ctx.createLinearGradient(PADDING, 0, PADDING + 170, 0);
      accent.addColorStop(0, '#ff4d8d');
      accent.addColorStop(1, '#8b6cff');
      ctx.fillStyle = accent;
      ctx.fillRect(PADDING, 118, 170, 6);

      ctx.textAlign = 'left';
      ctx.textBaseline = 'alphabetic';

      ctx.fillStyle = 'rgba(232, 233, 245, 0.55)';
      ctx.font = `500 26px ${CN_FONT}`;
      ctx.fillText('OC PSYCHE PROFILE / 十维人格侧写', PADDING, 186);

      const nameSize = fitFontSize(ctx, name, CARD_WIDTH - PADDING * 2, 78, '700', 40);
      ctx.font = `700 ${nameSize}px ${CN_FONT}`;
      ctx.fillStyle = '#ffffff';
      ctx.fillText(name, PADDING, 302);

      const ranked = [...DIMENSION_META].sort((a, b) => scores[b.key] - scores[a.key]);
      const top = ranked[0];
      ctx.font = `400 28px ${CN_FONT}`;
      ctx.fillStyle = 'rgba(232, 233, 245, 0.62)';
      ctx.fillText(`核心倾向：${top.label} ${scores[top.key]} / 100`, PADDING, 366);

      ctx.strokeStyle = 'rgba(160, 170, 255, 0.18)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(PADDING, 424);
      ctx.lineTo(right, 424);
      ctx.stroke();

      const barX = PADDING;
      const barWidth = right - PADDING;
      const barHeight = 20;
      const rowGap = 112;
      const radius = barHeight / 2;

      const barFill = ctx.createLinearGradient(barX, 0, barX + barWidth, 0);
      barFill.addColorStop(0, '#ff4d8d');
      barFill.addColorStop(0.6, '#8b6cff');
      barFill.addColorStop(1, '#4dd0ff');

      let rowY = 512;

      for (const meta of DIMENSION_META) {
        const value = scores[meta.key];

        ctx.textAlign = 'left';
        ctx.font = `500 34px ${CN_FONT}`;
        ctx.fillStyle = 'rgba(232, 233, 245, 0.94)';
        ctx.fillText(meta.label, barX, rowY);
        const labelWidth = ctx.measureText(meta.label).width;

        ctx.font = `400 19px ${MONO_FONT}`;
        ctx.fillStyle = 'rgba(139, 143, 168, 0.8)';
        ctx.fillText(meta.en, barX + labelWidth + 14, rowY - 2);

        ctx.textAlign = 'right';
        ctx.font = `700 40px ${MONO_FONT}`;
        ctx.fillStyle = '#ffffff';
        ctx.fillText(String(value), right, rowY);
        ctx.textAlign = 'left';

        const trackY = rowY + 24;
        roundRect(ctx, barX, trackY, barWidth, barHeight, radius);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.07)';
        ctx.fill();

        const fillWidth = (barWidth * value) / 100;
        if (fillWidth > 0) {
          roundRect(ctx, barX, trackY, Math.max(fillWidth, barHeight), barHeight, radius);
          ctx.fillStyle = barFill;
          ctx.fill();
        }

        const midX = barX + barWidth / 2;
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.16)';
        ctx.beginPath();
        ctx.moveTo(midX, trackY - 3);
        ctx.lineTo(midX, trackY + barHeight + 3);
        ctx.stroke();

        rowY += rowGap;
      }

      ctx.strokeStyle = 'rgba(160, 170, 255, 0.18)';
      ctx.beginPath();
      ctx.moveTo(PADDING, 1702);
      ctx.lineTo(right, 1702);
      ctx.stroke();

      ctx.font = `400 24px ${CN_FONT}`;
      ctx.fillStyle = 'rgba(139, 143, 168, 0.8)';
      ctx.fillText(`生成于 ${formatDate(new Date())}`, PADDING, 1762);

      ctx.textAlign = 'right';
      ctx.font = `400 22px ${MONO_FONT}`;
      ctx.fillStyle = 'rgba(160, 170, 255, 0.7)';
      ctx.fillText('OC PSYCHE ENGINE', right, 1762);
      ctx.textAlign = 'left';

      const footer = ctx.createLinearGradient(0, 1820, CARD_WIDTH, 1820);
      footer.addColorStop(0, 'rgba(255, 77, 141, 0)');
      footer.addColorStop(0.5, 'rgba(255, 77, 141, 0.55)');
      footer.addColorStop(1, 'rgba(77, 208, 255, 0)');
      ctx.fillStyle = footer;
      ctx.fillRect(0, 1838, CARD_WIDTH, 3);

      return canvas.toDataURL('image/png');
    }

    /* ==================== 2. 合盘计算（原 scoring.js） ==================== */

    const DIMENSION_KEYS = [
      'empathy',
      'order',
      'intellect',
      'vitality',
      'pride',
      'dominance',
      'self_destruction',
      'masochism',
      'obsession',
      'destruction',
    ];

    const DIMENSION_LABELS = {
      empathy: '共情力',
      order: '秩序感',
      intellect: '智谋度',
      vitality: '向阳心',
      pride: '自尊感',
      dominance: '支配欲',
      self_destruction: '自毁度',
      masochism: '痛觉度',
      obsession: '偏执狂',
      destruction: '破坏欲',
    };

    const DERIVED_META = [
      { key: 'conflict', label: '冲突指数', en: 'CONFLICT' },
      { key: 'redemption', label: '救赎概率', en: 'REDEMPTION' },
      { key: 'balance', label: '掌控平衡', en: 'BALANCE' },
      { key: 'resonance', label: '疯狂共振', en: 'RESONANCE' },
      { key: 'painLink', label: '痛觉链接', en: 'PAIN LINK' },
    ];

    const DERIVED_KEYS = DERIVED_META.map((meta) => meta.key);

    function clampValue(value) {
      const num = Number(value);
      if (!Number.isFinite(num)) return 0;
      return Math.min(100, Math.max(0, num));
    }

    function toScores(source) {
      const bag =
        source && typeof source.scores === 'object' && source.scores !== null ? source.scores : source || {};
      const scores = {};
      for (const key of DIMENSION_KEYS) {
        scores[key] = clampValue(bag[key]);
      }
      return scores;
    }

    function extractScores(input) {
      return toScores(input);
    }

    function decryptProfile(token) {
      const payload = decryptOC(token);
      if (!payload || typeof payload !== 'object') {
        throw new Error('数据格式不正确：缺少 10 维评分');
      }
      const name = String(payload.name || payload.nickname || '未命名 OC');
      return { name, scores: toScores(payload) };
    }

    function computeConflict(a, b) {
      const A = extractScores(a);
      const B = extractScores(b);
      return Math.round((A.pride + B.pride) / 2);
    }

    function computeRedemption(a, b) {
      const A = extractScores(a);
      const B = extractScores(b);
      return Math.round((A.self_destruction + B.empathy) / 2);
    }

    function computeBalance(a, b) {
      const A = extractScores(a);
      const B = extractScores(b);
      return Math.round(100 - Math.abs(A.dominance - B.dominance));
    }

    function computeResonance(a, b) {
      const A = extractScores(a);
      const B = extractScores(b);
      return Math.round((A.destruction + B.obsession) / 2);
    }

    function computePainLink(a, b) {
      const A = extractScores(a);
      const B = extractScores(b);
      return Math.round((A.masochism + B.masochism) / 2);
    }

    function computeDerived(a, b) {
      return {
        conflict: computeConflict(a, b),
        redemption: computeRedemption(a, b),
        balance: computeBalance(a, b),
        resonance: computeResonance(a, b),
        painLink: computePainLink(a, b),
      };
    }

    function analyzeCouple(tokenA, tokenB) {
      const a = decryptProfile(tokenA);
      const b = decryptProfile(tokenB);
      return { a, b, derived: computeDerived(a.scores, b.scores) };
    }

