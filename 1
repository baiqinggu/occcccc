          desc: '疼是你们之间唯一诚实的语言。谁先喊停，谁就先承认自己舍不得——而你们谁都不会先喊。',
        },
        {
          title: '《伤痕契约》',
          desc: '你身上的每一道旧伤他都能准确说出位置，那是比誓言更牢的契约：以血肉为印，以余生日日履行。',
        },
      ],
    };

    const nodes = {
      nicknameInput: document.getElementById('nickname-input'),
      registerBtn: document.getElementById('btn-register'),
      registerKey: document.getElementById('register-key'),
      keyInput: document.getElementById('key-input'),
      loginBtn: document.getElementById('btn-login'),
      session: document.getElementById('session-status'),
      fileInput: document.getElementById('file-input'),
      fileName: document.getElementById('file-name'),
      uploadBtn: document.getElementById('btn-upload'),
      matchBtn: document.getElementById('btn-match'),
      matchHint: document.getElementById('match-hint'),
      resetBtn: document.getElementById('btn-reset'),
      derivedPanel: document.getElementById('panel-derived'),
      derivedChart: document.getElementById('derived-chart'),
      entryTitle: document.getElementById('entry-title'),
      entryDesc: document.getElementById('entry-desc'),
      couponInput: document.getElementById('coupon-input'),
      redeemBtn: document.getElementById('btn-redeem'),
      feedbackOpenBtn: document.getElementById('btn-feedback-open'),
      feedbackModal: document.getElementById('feedback-modal'),
      feedbackBackdrop: document.getElementById('feedback-backdrop'),
      feedbackText: document.getElementById('feedback-text'),
      feedbackCount: document.getElementById('feedback-count'),
      feedbackError: document.getElementById('feedback-error'),
      feedbackSubmitBtn: document.getElementById('btn-feedback-submit'),
      feedbackCancelBtn: document.getElementById('btn-feedback-cancel'),
    };

    const radarNodes = {
      a: document.getElementById('radar-chart-a'),
      b: document.getElementById('radar-chart-b'),
    };

    const slotTitleNodes = {
      a: document.getElementById('slot-title-a'),
      b: document.getElementById('slot-title-b'),
    };

    const state = {
      key: '',
      text: '',
      fileName: '',
      user: null,
      profiles: { a: null, b: null },
    };

    const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

    function readStoredKey() {
      try {
        return localStorage.getItem(STORAGE_KEY) || '';
      } catch {
        return '';
      }
    }

    function writeStoredKey(key) {
      try {
        localStorage.setItem(STORAGE_KEY, key);
      } catch {
        /* ignore */
      }
    }

    function clearStoredKey() {
      try {
        localStorage.removeItem(STORAGE_KEY);
      } catch {
        /* ignore */
      }
    }

    function setBusy(button, busy, busyText) {
      if (busy) {
        if (!button.dataset.idleLabel) button.dataset.idleLabel = button.textContent.trim();
        button.textContent = busyText;
        button.disabled = true;
      } else {
        button.textContent = button.dataset.idleLabel || button.textContent.trim();
        delete button.dataset.idleLabel;
        button.disabled = false;
      }
    }

    function describeError(error) {
      return (error && error.message) || String(error);
    }

    function renderSession() {
      const user = state.user;
      if (!user) {
        nodes.session.textContent = '未登录';
        nodes.session.classList.remove('is-online');
        return;
      }
      const balance = Number.isFinite(user.balance) ? user.balance : 0;
      nodes.session.textContent = `${user.nickname} · 余额 ${balance} 点`;
      nodes.session.classList.add('is-online');
    }

    function applySession(data) {
      state.key = data.key;
      state.user = data.user;
      writeStoredKey(data.key);
      nodes.registerKey.textContent = data.key;
      nodes.keyInput.value = data.key;
      renderSession();
    }

    nodes.registerBtn.addEventListener('click', async () => {
      if (nodes.registerBtn.disabled) return;

      const nickname = nodes.nicknameInput.value.trim();
      if (!nickname) {
        alert('请先输入昵称');
        nodes.nicknameInput.focus();
        return;
      }

      setBusy(nodes.registerBtn, true, '签发中…');
      try {
        const data = await auth(nickname);
        applySession(data);
        console.log('[auth]', data.user);
        alert(`灵魂契约已签定。\n\n你的密钥：${data.key}\n\n请立即截图保存，这是唯一凭证，丢失无法找回。`);
      } catch (error) {
        alert(`签定失败：${describeError(error)}`);
      } finally {
        setBusy(nodes.registerBtn, false);
      }
    });

    async function doLogin(key, { silent = false } = {}) {
      setBusy(nodes.loginBtn, true, '验证中…');
      try {
        const data = await login(key);
        applySession(data);
        if (silent) console.log('[login] 自动登录成功', data.user);
        return data;
      } finally {
        setBusy(nodes.loginBtn, false);
      }
    }

    nodes.loginBtn.addEventListener('click', async () => {
      if (nodes.loginBtn.disabled) return;

      const key = nodes.keyInput.value.trim();
      if (!key) {
        alert('请输入密钥');
        nodes.keyInput.focus();
        return;
      }

      try {
        const data = await doLogin(key);
        console.log('[login]', data.user);
      } catch (error) {
        alert(`登录失败：${describeError(error)}`);
      }
    });

    nodes.fileInput.addEventListener('change', () => {
      const file = nodes.fileInput.files && nodes.fileInput.files[0];
      if (!file) return;

      state.text = '';
      state.fileName = '';
      nodes.fileName.textContent = '读取中…';

      if (!/\.txt$/i.test(file.name)) {
        nodes.fileName.textContent = '仅支持 .txt 文本文件';
        alert('仅支持 .txt 文本文件');
        nodes.fileInput.value = '';
        return;
      }

      const reader = new FileReader();

      reader.onload = () => {
        const text = typeof reader.result === 'string' ? reader.result : '';

        if (!text.trim()) {
          nodes.fileName.textContent = '文件内容为空';
          alert('文件内容为空，请重新选择');
          nodes.fileInput.value = '';
          return;
        }

        if (text.length > TEXT_LIMIT) {
          nodes.fileName.textContent = `文本 ${text.length} 字符，超过上限 ${TEXT_LIMIT}`;
          alert(`文本长度 ${text.length} 字符，超过上限 ${TEXT_LIMIT} 字符`);
          nodes.fileInput.value = '';
          return;
        }

        state.text = text;
        state.fileName = file.name;
        nodes.fileName.textContent = `${file.name} · ${text.length} 字符`;
      };

      reader.onerror = () => {
        nodes.fileName.textContent = '文件读取失败';
        alert('文件读取失败，请重试');
      };

      reader.readAsText(file, 'utf-8');
    });

    function nextSlotKey() {
      if (!state.profiles.a) return 'a';
      if (!state.profiles.b) return 'b';
      return 'a';
    }

    function updateMatchAvailability() {
      const ready = Boolean(state.profiles.a && state.profiles.b);
      nodes.matchBtn.disabled = !ready;
      nodes.matchHint.textContent = ready ? '两份侧写已就位，点击开始合盘' : '上传两份 OC 文本后即可合盘';
    }

    function setSlotProfile(slotKey, profile) {
      state.profiles[slotKey] = profile;
      renderOCRadar(radarNodes[slotKey], profile, SLOT_COLORS[slotKey]);
      const title = slotTitleNodes[slotKey];
      if (title) title.textContent = `OC ${slotKey.toUpperCase()} · ${profile.name}`;
      updateMatchAvailability();
    }

    function resetMatchView() {
      for (const key of ['a', 'b']) {
        const el = radarNodes[key];
        if (!el) continue;
        el.classList.remove('explode-anim');
        el.style.removeProperty('display');
        el.style.removeProperty('opacity');
        el.style.removeProperty('transform');
      }
      nodes.derivedPanel.hidden = true;
      nodes.matchBtn.textContent = '开始合盘';
      updateMatchAvailability();
    }

    function pickEntry(derived) {
      const ranked = [...DERIVED_ORDER].sort((x, y) => (derived[y] || 0) - (derived[x] || 0));
      const topKey = ranked[0];
      const pool = MATCH_ENTRIES[topKey] || MATCH_ENTRIES.conflict;
      const secondary = derived[ranked[1]] || 0;
      return { key: topKey, entry: pool[secondary >= 60 ? 1 : 0] || pool[0] };
    }

    async function runMatch() {
      const a = state.profiles.a;
      const b = state.profiles.b;
      if (!a || !b) {
        alert('需要两份 OC 侧写才能合盘');
        return;
      }
      if (nodes.matchBtn.disabled) return;

      nodes.matchBtn.disabled = true;
      nodes.matchBtn.textContent = '合盘中…';

      radarNodes.a.classList.add('explode-anim');
      radarNodes.b.classList.add('explode-anim');

      await wait(EXPLODE_MS);

      radarNodes.a.style.display = 'none';
      radarNodes.b.style.display = 'none';

      const derived = computeDerived(a.scores, b.scores);
      nodes.derivedPanel.hidden = false;
      const chart = renderDerivedRadar(nodes.derivedChart, derived);
      requestAnimationFrame(() => chart && chart.resize());

      const { entry } = pickEntry(derived);
      nodes.entryTitle.textContent = entry.title;
      nodes.entryDesc.textContent = entry.desc;

      nodes.matchBtn.textContent = '已合盘';
      nodes.matchBtn.disabled = true;
      nodes.derivedPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    nodes.matchBtn.addEventListener('click', () => {
      runMatch().catch((error) => {
        alert(`合盘失败：${describeError(error)}`);
        resetMatchView();
      });
    });

    nodes.resetBtn.addEventListener('click', () => {
      resetMatchView();
      if (state.profiles.a) renderOCRadar(radarNodes.a, state.profiles.a, SLOT_COLORS.a);
      if (state.profiles.b) renderOCRadar(radarNodes.b, state.profiles.b, SLOT_COLORS.b);
    });

    nodes.uploadBtn.addEventListener('click', async () => {
      if (nodes.uploadBtn.disabled) return;

      if (!state.key) {
        alert('请先签定灵魂契约或使用密钥登录');
        return;
      }
      if (!state.text) {
        alert('请先上传角色 TXT 文件');
        return;
      }

      setBusy(nodes.uploadBtn, true, '侧写中，请稍候…');
      try {
        const data = await parseText(state.key, state.text);
        console.log('[parse] 侧写结果', data);
        console.log('[parse] 10 维评分', data.scores);

        if (state.user && Number.isFinite(data.balance)) {
          state.user.balance = data.balance;
          renderSession();
        }

        resetMatchView();
        const slotKey = nextSlotKey();
        const profileName = (state.fileName || '未知 OC').replace(/\.txt$/i, '');
        setSlotProfile(slotKey, { name: profileName, scores: data.scores });

        alert(
          `侧写完成\n模型：${data.model}\n字符：${data.charCount}\n消耗：${data.cost} 点\n余额：${data.balance} 点\n\n已填入 OC ${slotKey.toUpperCase()} 雷达，详细评分见控制台`
        );
      } catch (error) {
        alert(`侧写失败：${describeError(error)}`);
      } finally {
        setBusy(nodes.uploadBtn, false);
      }
    });

    const FEEDBACK_MIN = 20;
    const FEEDBACK_MAX = 200;

    function feedbackLength() {
      return [...nodes.feedbackText.value.trim()].length;
    }

    function syncFeedbackCount() {
      nodes.feedbackCount.textContent = `${feedbackLength()} / ${FEEDBACK_MAX}`;
    }

    function openFeedback() {
      if (!state.key) {
        alert('请先签定灵魂契约或使用密钥登录');
        return;
      }
      nodes.feedbackError.textContent = '';
      nodes.feedbackText.value = '';
      nodes.feedbackModal.hidden = false;
      syncFeedbackCount();
      setTimeout(() => nodes.feedbackText.focus(), 30);
    }

    function closeFeedback() {
      nodes.feedbackModal.hidden = true;
    }

    nodes.feedbackText.addEventListener('input', () => {
      nodes.feedbackError.textContent = '';
      syncFeedbackCount();
    });

    nodes.feedbackOpenBtn.addEventListener('click', openFeedback);
    nodes.feedbackCancelBtn.addEventListener('click', closeFeedback);
    nodes.feedbackBackdrop.addEventListener('click', closeFeedback);

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !nodes.feedbackModal.hidden) closeFeedback();
    });

    nodes.feedbackSubmitBtn.addEventListener('click', async () => {
      if (nodes.feedbackSubmitBtn.disabled) return;
      if (!state.key) {
        alert('请先签定灵魂契约或使用密钥登录');
        return;
      }

      const text = nodes.feedbackText.value.trim();
      const length = [...text].length;
      if (length < FEEDBACK_MIN || length > FEEDBACK_MAX) {
        nodes.feedbackError.textContent = `需 ${FEEDBACK_MIN}-${FEEDBACK_MAX} 字，当前 ${length} 字`;
        nodes.feedbackText.focus();
        return;
      }

      setBusy(nodes.feedbackSubmitBtn, true, '提交中…');
      try {
        const data = await feedback(state.key, text);
        closeFeedback();
        nodes.couponInput.value = data.coupon;
        alert(
          `反馈已收到，感谢！\n\n你的体验券：${data.coupon}\n\n券码已填入兑换框，点击兑换即可 +${data.reward} 虚拟币。`
        );
      } catch (error) {
        const message = describeError(error);
        nodes.feedbackError.textContent = message;
        alert(`提交失败：${message}`);
      } finally {
        setBusy(nodes.feedbackSubmitBtn, false);
      }
    });

    nodes.redeemBtn.addEventListener('click', async () => {
      if (nodes.redeemBtn.disabled) return;
      if (!state.key) {
        alert('请先签定灵魂契约或使用密钥登录');
        return;
      }

      const coupon = nodes.couponInput.value.trim();
      if (!coupon) {
        alert('请输入券码');
        nodes.couponInput.focus();
        return;
      }

      setBusy(nodes.redeemBtn, true, '兑换中…');
      try {
        const data = await useCoupon(state.key, coupon);
        if (state.user) {
          state.user.balance = data.balance;
          renderSession();
        }
        nodes.couponInput.value = '';
        alert(`兑换成功\n奖励：+${data.reward} 虚拟币\n当前余额：${data.balance} 点`);
      } catch (error) {
        alert(`兑换失败：${describeError(error)}`);
      } finally {
        setBusy(nodes.redeemBtn, false);
      }
    });

    (async function boot() {
      const stored = readStoredKey();
      if (!stored) return;

      nodes.keyInput.value = stored;
      try {
        await doLogin(stored, { silent: true });
      } catch (error) {
        clearStoredKey();
        state.key = '';
        state.user = null;
        nodes.keyInput.value = '';
        renderSession();
        alert(`自动登录失败：${describeError(error)}\n本地密钥已清除，请重新签定或手动输入密钥。`);
      }
    })();
  </script>
</body>
</html>
